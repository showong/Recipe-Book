# ============================================================================
# Recipe Book — 환경변수 템플릿
# 실제 값은 .env.local 에 작성하세요 (.env.local 은 git에 커밋되지 않습니다).
# 배포 환경(Vercel 등)에서는 대시보드의 Environment Variables 에 등록하세요.
# ============================================================================

# ── Supabase (웹 배포용 영속 저장소) ────────────────────────────────────────
# 아래 두 값이 모두 설정되면 레시피/이미지 저장소가 자동으로 Supabase로 전환됩니다.
# 비워두면 로컬 파일(data/) 기반으로 동작합니다 (로컬 개발).
#
# ⚠️ SERVICE_ROLE 키는 전권(RLS 우회) 키입니다.
#    - 절대 NEXT_PUBLIC_ 접두사를 붙이지 마세요 (브라우저 노출 금지).
#    - 배포 시 Production 환경 + "Sensitive" 변수로만 등록하세요.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 이미지 저장 버킷 이름 (기본값: recipe-images, schema.sql과 일치해야 함)
SUPABASE_STORAGE_BUCKET=recipe-images

# ── AI / 외부 서비스 키 (서버 전용) ─────────────────────────────────────────
GOOGLE_API_KEY=
OPENAI_API_KEY=
TAVILY_API_KEY=
TYPECAST_API_KEY=

# ── Telegram 전송 (선택) ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 관리자 인증 ─────────────────────────────────────────────────────────────
ADMIN_EMAILS=
ADMIN_SECRET=
